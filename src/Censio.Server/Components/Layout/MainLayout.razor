@inherits LayoutComponentBase
@implements IDisposable
@using System.Globalization

<div class="censio-frame">
    <MudThemeProvider Theme="_mudTheme" IsDarkMode="_theme == UiTheme.Dark" ObserveSystemDarkModeChange="false" />
    <MudPopoverProvider />
    <MudLayout>
        <MudAppBar Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="@_texts.NavigationButton" OnClick="ToggleDrawer" />
            <MudText Typo="Typo.h6">Censio</MudText>
            <MudSpacer />
            <MudMenu Label="@_texts.ProfileSwitch" StartIcon="@Icons.Material.Filled.Person" Color="Color.Inherit" Variant="Variant.Text" Disabled="@(_profileItems.Count == 0)" MaxHeight="400" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                @foreach (var item in _profileItems)
                {
                    <MudMenuItem Href="@PageAddress.RegionsLink(item.Key)">@item.Value</MudMenuItem>
                }
                @if (_moreProfiles > 0)
                {
                    <MudMenuItem Disabled="true">@string.Format(CultureInfo.InvariantCulture, _texts.MoreProfilesFormat, _moreProfiles)</MudMenuItem>
                }
            </MudMenu>
            <MudMenu Icon="@Icons.Material.Filled.Translate" Color="Color.Inherit" AriaLabel="@_texts.LanguageSwitch" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem OnClick="() => ChooseLanguageAsync(UiLanguage.English)">@UiTexts.LanguageName(UiLanguage.English)</MudMenuItem>
                <MudMenuItem OnClick="() => ChooseLanguageAsync(UiLanguage.German)">@UiTexts.LanguageName(UiLanguage.German)</MudMenuItem>
            </MudMenu>
            <MudIconButton Icon="@(_theme == UiTheme.Dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" aria-label="@(_theme == UiTheme.Dark ? _texts.SwitchToLightTheme : _texts.SwitchToDarkTheme)" OnClick="ToggleThemeAsync" />
        </MudAppBar>
        <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always">
            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">@_texts.HomeEntry</MudNavLink>
                <MudNavLink Href="/regions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Map">@_texts.RegionsEntry</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
        <MudMainContent>
            <MudContainer>
                <CascadingValue Value="_language">
                    <CascadingValue Value="_texts">
                        @Body
                    </CascadingValue>
                </CascadingValue>
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</div>
