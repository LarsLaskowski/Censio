@page "/regions"
@page "/profiles/{Profile}/regions"
@inherits DataPageBase

<PageTitle>@($"Censio – {Heading}")</PageTitle>

<h1 class="mud-typography mud-typography-h4">@Heading</h1>

@if (Mode == PageMode.Ready && View is { } view)
{
    <p>@ProfileLabel(view)</p>
}
@if (Mode != PageMode.NotFound)
{
    <DataStatus AsOf="View?.AsOf" />
}
@if (StatusText is { } status)
{
    <p>@status</p>
}
else if (View is { } shown)
{
    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            <tr>
                <th>@Texts.ColumnRegion</th>
                <th class="censio-number">@Texts.ColumnIslands</th>
                <th class="censio-number">@Texts.ColumnBuildings</th>
                <th class="censio-number">@Texts.ColumnProducedGoods</th>
                <th class="censio-number">@Texts.ColumnGoodsInDeficit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var region in PageNames.OrderRegions(shown.Regions, Language))
            {
                <tr>
                    <td><MudLink Href="@PageAddress.RegionLink(shown.ProfileId, region.SessionGuids[0])">@PageNames.RegionText(region, shown.Regions, Language)</MudLink></td>
                    <td class="censio-number">@PageFormat.Count(region.Islands.Count)</td>
                    <td class="censio-number">@PageFormat.Count(region.Figures?.Buildings)</td>
                    <td class="censio-number">@PageFormat.Count(region.Figures?.ProducedGoods)</td>
                    <td class="censio-number">@PageFormat.Count(region.Figures?.GoodsInDeficit)</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}
