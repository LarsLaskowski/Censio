<Window x:Class="Censio.Companion.RenameProfileDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <TextBox x:Name="NameBox" Margin="0,8,0,0" />
        <TextBlock x:Name="ProblemText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="Firebrick" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RenameButton" IsDefault="True" MinWidth="88" Margin="0,0,8,0" Padding="12,3" />
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="88" Padding="12,3" />
        </StackPanel>
    </StackPanel>
</Window>
