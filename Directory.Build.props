<Project>
  <!-- One build structure in every .NET repository of the template (.squad/stack.md, Toolchain): the target framework
       and these switches are set here once, never in a project file; dotnet_config.py checks it in the Analyzer gate.
       The values of the target framework and the packages are the project's. Censio.Companion names its platform,
       net11.0-windows, in its own project file (record 0004). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>
  <!-- The product version: one build property, 0.0.0 on main, set only by the release build (record 0005) -->
  <PropertyGroup>
    <Product>Censio</Product>
    <Version>0.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="CensioBuildVersion" Value="$(Version)" />
  </ItemGroup>
  <!-- The analyzers in every project, dev-only, so SonarQube Cloud's issues surface in the local build -->
  <ItemGroup>
    <PackageReference Include="Reihitsu.Analyzer" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
    <PackageReference Include="MSTest.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <!-- Every test project (name ending in .Tests): MSTest and coverage -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
</Project>
